    "/api/events/{event_id}/annotation": {
      "post": {
        "description": "Writes a multi-value register. Concurrent writes on different nodes are all kept\nand shown as a conflict, never silently resolved. A write over a conflict supersedes\nevery value and appends a signed RESOLUTION entry naming them. 422 on an unknown field\nor triage status; 403 on a read-only node.",
        "operationId": "annotation_api_events__event_id__annotation_post",
        "parameters": [
          {
            "in": "path",
            "name": "event_id",
            "required": true,
            "schema": {
              "title": "Event Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "field": {
                    "enum": [
                      "triage_status",
                      "assignee",
                      "note"
                    ]
                  },
                  "value": {
                    "description": "for triage_status, one of NEW, WATCH, MANEUVER_PLANNING, NO_ACTION, CLOSED"
                  }
                },
                "required": [
                  "field",
                  "value"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Annotation Api Events  Event Id  Annotation Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set an annotation",
        "tags": [
          "operator data"
        ]
      }
    },
    "/api/events/{event_id}/decision": {
      "post": {
        "description": "Appends a signed DECISION to the log, bound to the event's current CDM. 422 on a\ndecision outside the list; 403 on a read-only node.",
        "operationId": "decision_api_events__event_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "event_id",
            "required": true,
