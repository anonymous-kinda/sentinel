    "/api/ingest/cdm": {
      "post": {
        "description": "The admission policy of docs/icd/cdm-profile.md: wrong input is quarantined with\na code, incomplete input is accepted with warnings. Admitted as REAL data unless its\nORIGINATOR marks it EXERCISE or DERIVED.",
        "operationId": "ingest_api_ingest_cdm_post",
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "One CCSDS 508.0-B-1 CDM in KVN, UTF-8 or ASCII, at most 1 MB.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "properties": {
                    "code": {
                      "description": "rejection code (docs/icd/cdm-profile.md)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "detail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_id": {
                      "description": "the event the CDM joined (accepted only)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sha256": {
                      "description": "of the bytes as received",
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "accepted",
                        "duplicate",
                        "rejected"
                      ]
                    },
                    "warnings": {
                      "items": {
                        "properties": {
                          "code": {
                            "description": "warning code (docs/icd/cdm-profile.md)",
                            "type": "string"
                          },
                          "detail": {
                            "description": "what was found",
                            "type": "string"
                          },
                          "key": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "object_index": {
                            "description": "0 = OBJECT1, 1 = OBJECT2",
                            "type": [
                              "integer",
                              "null"
                            ]
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "status",
                    "sha256"
                  ],
                  "title": "Response Ingest Api Ingest Cdm Post",
                  "type": "object"
                }
              }
            },
            "description": "Duplicate: these exact bytes (same sha256) were already admitted. No change."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "rejection code (docs/icd/cdm-profile.md)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "detail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_id": {
                      "description": "the event the CDM joined (accepted only)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sha256": {
                      "description": "of the bytes as received",
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "accepted",
                        "duplicate",
                        "rejected"
                      ]
                    },
                    "warnings": {
                      "items": {
                        "properties": {
                          "code": {
                            "description": "warning code (docs/icd/cdm-profile.md)",
                            "type": "string"
                          },
                          "detail": {
                            "description": "what was found",
                            "type": "string"
                          },
                          "key": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "object_index": {
                            "description": "0 = OBJECT1, 1 = OBJECT2",
                            "type": [
                              "integer",
                              "null"
                            ]
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "status",
                    "sha256"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Accepted and assessed. `warnings` lists anything that limits what can be concluded."
          },
          "403": {
            "description": "This node is read-only."
          },
          "413": {
            "description": "Larger than 1 MB. A CDM is a few kilobytes."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "description": "rejection code (docs/icd/cdm-profile.md)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "detail": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_id": {
                      "description": "the event the CDM joined (accepted only)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sha256": {
                      "description": "of the bytes as received",
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "accepted",
                        "duplicate",
                        "rejected"
                      ]
                    },
                    "warnings": {
                      "items": {
                        "properties": {
                          "code": {
                            "description": "warning code (docs/icd/cdm-profile.md)",
                            "type": "string"
                          },
                          "detail": {
                            "description": "what was found",
                            "type": "string"
                          },
                          "key": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "object_index": {
                            "description": "0 = OBJECT1, 1 = OBJECT2",
                            "type": [
                              "integer",
                              "null"
                            ]
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "status",
                    "sha256"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Rejected and quarantined, with a `code` from docs/icd/cdm-profile.md."
          }
        },
        "summary": "Admit one CDM (CCSDS 508.0-B-1 KVN)",
        "tags": [
          "conjunctions"
        ]
      }
    },
