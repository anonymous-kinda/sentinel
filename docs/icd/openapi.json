    "/api/screening": {
      "post": {
        "description": "Close approaches to the primary over the next `hours`, each filed as a DERIVED CDM\nwith no covariance, so the engine refuses its Pc. 404 when this node has no element\nset for the primary; 422 on wrong input; 403 on a read-only node. See\ndocs/icd/screening-api.md.",
        "operationId": "screening_api_screening_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "hours": {
                    "default": 24,
                    "exclusiveMinimum": 0.0,
                    "maximum": 72.0,
                    "type": "number"
                  },
                  "primary_norad_id": {
                    "minimum": 1.0,
                    "type": "integer"
                  },
                  "threshold_km": {
                    "default": 5,
                    "exclusiveMinimum": 0.0,
                    "maximum": 50.0,
                    "type": "number"
                  }
                },
                "required": [
                  "primary_norad_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Screening Api Screening Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
