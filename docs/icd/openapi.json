        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "decision": {
                    "enum": [
                      "MANEUVER",
                      "NO_MANEUVER",
                      "MONITOR",
                      "REQUEST_TASKING"
                    ]
                  },
                  "rationale": {
                    "description": "truncated to 2000 characters",
                    "type": "string"
                  }
                },
                "required": [
                  "decision"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Decision Api Events  Event Id  Decision Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Record a decision",
        "tags": [
          "operator data"
        ]
      }
    },
