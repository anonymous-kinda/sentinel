{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The HTTP interface of one Sentinel node: hub, edge or standalone. Every node serves its own console from its own data (ADR-009), so nothing here depends on the link to another node. Times are ISO 8601 UTC and units are field-name suffixes (`_m`, `_m_s`, `_km`, `_s`). A read-only node answers every write with 403. The acting operator is named by the `X-Sentinel-Operator` header, set by the front proxy. Interface control documents: docs/icd/README.md.",
    "title": "Sentinel",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ai/ask": {
      "post": {
        "description": "An answer phrased from tool facts (every number checked by the grounding guard), a\nquestion back when the request is ambiguous, or a draft action that takes effect only\non /api/ai/confirm. 422 on an empty or over-long question.",
        "operationId": "ai_ask_api_ai_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "text": {
                    "description": "1 to 2000 characters",
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ai Ask Api Ai Ask Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ask the assistant",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/ai/audit": {
      "get": {
        "description": "The most recent asks and confirms (`limit` 1 to 500), each hash-chained to the one\nbefore.",
        "operationId": "ai_audit_api_ai_audit_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Ai Audit Api Ai Audit Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Assistant audit record",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/ai/audit/verify": {
      "get": {
        "description": "Reads the audit file as it is now, recomputes the hash chain and holds it against the\nlines this node wrote. Reports the first line that does not link, cannot be read (a\nwrite torn by a power cut) or has changed or gone since it was written, if any. A\nbroken chain stays broken: entries recorded after the break never make it verify.",
        "operationId": "ai_audit_verify_api_ai_audit_verify_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ai Audit Verify Api Ai Audit Verify Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Verify the audit chain",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/ai/confirm": {
      "post": {
        "description": "The operator confirms a draft once; it becomes a signed DECISION. 404 for an unknown\ndraft, 409 when the event's CDM changed since the draft (stale), 403 on a read-only\nnode.",
        "operationId": "ai_confirm_api_ai_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "draft_id": {
                    "description": "from an ask answer",
                    "type": "string"
                  },
                  "rationale": {
                    "description": "truncated to 2000 characters",
                    "type": "string"
                  }
                },
                "required": [
                  "draft_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ai Confirm Api Ai Confirm Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Confirm a drafted decision",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/ai/status": {
      "get": {
        "description": "The routing and phrasing tier in force and the reason for it: hosted AI needs an\nUNCLASSIFIED marking, operator opt-in and a usable measured link. Lists which hosted\nproviders are configured and their pinned models.",
        "operationId": "ai_status_api_ai_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ai Status Api Ai Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Assistant tier and why",
        "tags": [
          "assistant"
        ]
      }
    },
    "/api/demo/link": {
      "post": {
        "description": "Demonstration and harness only: drives the link emulator. 403 unless demo controls\nare on and the caller is on localhost; 503 without an emulator; 422 on an unknown\npreset.",
        "operationId": "demo_link_api_demo_link_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "preset": {
                    "enum": [
                      "CONNECTED",
                      "DEGRADED",
                      "DENIED",
                      "LIMITED"
                    ]
                  }
                },
                "required": [
                  "preset"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Demo Link Api Demo Link Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Apply a link-emulation preset (demo only)",
        "tags": [
          "link and sync"
        ]
      }
    },
    "/api/events": {
      "get": {
        "description": "`scope`: `active` (TCA in the future, soonest maneuver commit point first),\n`past` or `all` (newest TCA first); 400 otherwise. An edge also lists events it\nknows only from the hub's summaries, marked `verification: HUB_ASSERTED` until\ntheir CDMs arrive and are re-assessed locally.",
        "operationId": "events_api_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "scope",
            "required": false,
            "schema": {
              "default": "active",
              "title": "Scope",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Events Api Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List conjunction events",
        "tags": [
          "conjunctions"
        ]
      }
    },
    "/api/events/{event_id}": {
      "get": {
        "description": "The event summary, every CDM received for it with its own assessment and\nadmission warnings, and the engine version and policy that produced them. 404 when\nthe event is unknown.",
