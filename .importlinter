[importlinter]
root_package = sentinel
include_external_packages = True

[importlinter:contract:risk-pure]
name = The risk engine is pure maths: no I/O, transport, web or storage
type = forbidden
source_modules =
    sentinel.risk
forbidden_modules =
    fastapi
    nats
    sqlite3
    httpx

[importlinter:contract:core-is-mission-agnostic]
name = The core (bus, triage) knows nothing about any mission module
type = forbidden
source_modules =
    sentinel.bus
    sentinel.triage
forbidden_modules =
    sentinel.conjunction
    sentinel.risk
    sentinel.cdm
    sentinel.api

[importlinter:contract:cdm-is-a-seam]
name = The CDM codec (ADR-001 seam) does not depend on services above it
type = forbidden
source_modules =
    sentinel.cdm
forbidden_modules =
    sentinel.conjunction
    sentinel.api
    sentinel.bus

[importlinter:contract:sync-is-mission-agnostic]
name = Sync, CRDTs and operator data know nothing about any mission module
type = forbidden
source_modules =
    sentinel.sync
    sentinel.crdt
    sentinel.ops
    sentinel.linkstate
forbidden_modules =
    sentinel.conjunction
    sentinel.risk
    sentinel.cdm
    sentinel.api

[importlinter:contract:ai-does-no-math]
name = The AI layer has no path to the maths: it asks tools, never computes
type = forbidden
source_modules =
    sentinel.ai
forbidden_modules =
    sentinel.risk
    sentinel.cdm
    numpy
    scipy

[importlinter:contract:hosted-ai-at-the-edges]
name = Hosted AI SDKs are confined to their adapters
type = forbidden
source_modules =
    sentinel.ai.assistant
    sentinel.ai.catalog
    sentinel.ai.grounding
    sentinel.ai.narrate
    sentinel.ai.policy
    sentinel.ai.router
    sentinel.ai.tools
forbidden_modules =
    typesafe_sdk
    anthropic

[importlinter:contract:passes-is-independent]
name = The pass module knows nothing about conjunction risk, sync internals or the API
type = forbidden
source_modules =
    sentinel.passes
forbidden_modules =
    sentinel.risk
    sentinel.cdm
    sentinel.conjunction
    sentinel.sync
    sentinel.api
    sentinel.ai

# --- M3 tabulated-ephemeris provider: ephemeris and adapters (append-only block) ---
[importlinter:contract:ephemeris-and-adapters-are-independent]
name = Ephemeris codecs and source adapters know nothing about risk, CDM services, conjunction, sync, the API or AI
type = forbidden
source_modules =
    sentinel.ephemeris
    sentinel.adapters
forbidden_modules =
    sentinel.risk
    sentinel.cdm
    sentinel.conjunction
    sentinel.sync
    sentinel.api
    sentinel.ai
# The one permitted edge into sentinel.cdm: the CCSDS 301.0 time-code parser,
# which every CCSDS message shares (CDM and OEM alike).
ignore_imports =
    sentinel.ephemeris.oem -> sentinel.cdm.timefmt

[importlinter:contract:ephemeris-is-below-passes]
name = Ephemeris tables sit below the pass module and the adapters that feed them
type = forbidden
source_modules =
    sentinel.ephemeris
forbidden_modules =
    sentinel.passes
    sentinel.adapters
# --- end M3 tabulated-ephemeris block ---

# --- screening (ADR-002 demonstration mode) ---------------------------------
[importlinter:contract:screening-never-decides-pc]
name = Screening produces element-set geometry; only the engine decides a Pc
type = forbidden
source_modules =
    sentinel.screening
forbidden_modules =
    sentinel.risk
    sentinel.conjunction
    sentinel.api
    sentinel.sync
    sentinel.ai
