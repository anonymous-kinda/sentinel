# Hosted AI settings. Copy to .env (gitignored), fill in, then load with: set -a; . ./.env; set +a
# Then `make ai-live-check` makes one real call per key set; `make ai-eval` scores Jev.

# TypeSafe API key: enables the Jev router (System One routing).
TYPESAFE_API_KEY=
# Anthropic API key: enables the Claude narrator (System Two phrasing).
ANTHROPIC_API_KEY=
# Operator opt-in for hosted AI on a running node (make serve); 1 to allow. The checks above ignore it.
SENTINEL_AI_CLOUD=0
